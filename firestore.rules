rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 관리자: Firebase에 만든 관리자 계정 이메일 (firebase-config.js의 admins와 같게)
    // 이 계정은 콘솔에서만 만들고, 콘솔에서 '새 계정 만들기(회원가입)'를 꺼 두세요.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['admin@sugang.school'];
    }

    // 학생 명단(이름·개인코드)은 관리자만 읽고 씁니다.
    match /admin/{doc=**} {
      allow read, write: if isAdmin();
    }

    // 과목, 설정, 확인용 해시, 전출 학번: 누구나 읽고 관리자만 씁니다.
    match /subjects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /rounds/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /meta/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 신청 명단: 학생(익명 로그인)은 정원을 넘지 않게, 한 번에 한 명씩만 바꿀 수 있습니다.
    match /enroll/{id} {
      allow read: if true;
      allow create, update: if isAdmin() || (
        request.auth != null
        && request.resource.data.keys().hasOnly(['students','t'])
        && request.resource.data.students is list
        && request.resource.data.students.size() <= get(/databases/$(database)/documents/subjects/$(id)).data.capacity
        && math.abs(request.resource.data.students.size() - (resource == null ? 0 : resource.data.students.size())) <= 1
      );
      allow delete: if isAdmin();
    }
  }
}
